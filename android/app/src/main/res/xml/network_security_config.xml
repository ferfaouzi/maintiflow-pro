<?xml version="1.0" encoding="utf-8"?>
<!-- Release : HTTPS obligatoire. Les certificats d'une autorité interne de l'usine
     (installée sur l'appareil par le service informatique) sont acceptés pour un serveur local. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <!-- Mode téléphone maître : le téléphone serveur se connecte à lui-même sans quitter l'appareil. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
