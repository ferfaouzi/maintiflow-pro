<?xml version="1.0" encoding="utf-8"?>
<!-- Release : HTTPS obligatoire. Les certificats d'une autorité interne de l'usine
     (installée sur l'appareil par le service informatique) sont acceptés pour un serveur local. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
